main :: fn() i32 {
  i: i32 = 0;
  defer i += 1;
  check1 := i == 0;

  // Check Block
  {
    defer i += 2;
  }
  check2 := i == 2;

  // Check If
  if (i == 2) {
    defer i += 3;
  }
  check3 := i == 5;

  // Check Loop
  for k in 0..<5 {
    defer i += 1;
  }
  check4 := i == 10;

  i *= 0;
  return !(check1 && check2 && check3 && check4 && i == 1) as i32;
}
